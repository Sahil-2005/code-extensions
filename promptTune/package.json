{
  "name": "prompttune",
  "displayName": "PromptTune — AI Prompt Optimizer",
  "publisher": "Sahil-2005",
  "icon": "images/icon.png",
  "description": "Instantly rewrite and optimize AI prompts using Gemini — select text, run the command, get a production-ready prompt.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Machine Learning",
    "Programming Languages"
  ],
  "keywords": [
    "AI",
    "Prompt Engineering",
    "Gemini",
    "LLM",
    "Prompt Optimization",
    "Google AI"
  ],
  "activationEvents": [
    "onCommand:prompttune.optimize",
    "onCommand:prompttune.optimizeFromClipboard"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "prompttune.optimize",
        "title": "PromptTune: Optimize Selected Text"
      },
      {
        "command": "prompttune.optimizeFromClipboard",
        "title": "PromptTune: Optimize from Clipboard"
      }
    ],
    "configuration": {
      "title": "PromptTune",
      "properties": {
        "prompttune.apiKey": {
          "type": "string",
          "default": "",
          "description": "Your Google Gemini API key. Get one at https://aistudio.google.com/apikey",
          "editPresentation": "singlelineText"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/sinon": "^21.0.0",
    "@types/vscode": "^1.109.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.2",
    "sinon": "^21.0.1",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1"
  }
}
